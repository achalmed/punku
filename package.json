{
  "name": "punku-desarrollo",
  "private": true,
  "description": "Las herramientas para construir y probar la página SOLA de Punku (web/). El paquete que monta un anfitrión es web/package.json, sin dependencias propias: usa las del anfitrión (una sola copia de React).",
  "type": "module",
  "scripts": {
    "web": "vite --config web/vite.config.ts",
    "web:construir": "tsc -p web && vite build --config web/vite.config.ts",
    "web:pruebas": "node --test --experimental-strip-types web/pruebas/*.test.ts"
  },
  "dependencies": {
    "@emotion/react": "^11.13.0",
    "@emotion/styled": "^11.13.0",
    "@mui/icons-material": "^5.16.7",
    "@mui/material": "^5.16.7",
    "@qillqa/tiqsi": "file:../tiqsi/web",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^6.4.4"
  }
}
